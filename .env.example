# Public Web3Forms Access Key for client-side form submission
# This key is public-only and safe to expose in client builds.
# Get a free key at web3forms.com and set its allowed domains.
NEXT_PUBLIC_WEB3FORMS_KEY=your_public_access_key_here

# Public contact address used by the feedback form (from_name/to) and the
# privacy/terms pages. Requires no secret - it is a public email address.
# When unset, the site falls back to the default address in the source.
NEXT_PUBLIC_NOTIFY_EMAIL=mzilab03dz@gmail.com
